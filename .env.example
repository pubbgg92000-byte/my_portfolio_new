# Resend (https://resend.com) — required for the contact form to send email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=mangalarapuarvind@gmail.com

# Sender. onboarding@resend.dev works for testing but can only deliver to
# the email on your Resend account. Verify your domain, then use e.g.
# "Arvind Portfolio <hello@arvind-dev.in>".
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Optional. Raises the GitHub API rate limit for the "Recent on GitHub" section
# (unauthenticated is 60 requests/hour per IP). A fine-grained token with no scopes is enough.
# GITHUB_TOKEN=github_pat_xxxxxxxx
